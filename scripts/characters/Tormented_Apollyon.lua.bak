local Mod = Torment

 -- Change every instance of the word "Template" in this file with your character's name, without spaces

local characterCostume = Isaac.GetCostumeIdByPath("gfx/characters/costume_template_5.anm2")

local function isEmpty(s)
	return s == nil or s == ''
end

local Template = { -- shown below are default values, as shown on Isaac, for you to change around
    SPEED = 1.00,
    FIREDELAY = 10, -- your tears stat is "30/(FIREDELAY+1)"
    DAMAGE = 3.5, -- is only the damage stat, not damage multiplier
    RANGE = 260, -- your range stat is "40*RANGE"
    SHOTSPEED = 1.00,
    LUCK = 0.00,
    TEARHEIGHT = 0.00, -- these are non default values, instead being additive to the default value because I do not know what the default is
    TEARFALLINGSPEED = 0.00, -- these are non default values, instead being additive to the default value because I do not know what the default is
    TEARFLAG = 0, -- Determines some behaviors of your tears, https://wofsauge.github.io/IsaacDocs/rep/enums/TearFlags.html
    TEARCOLOR = Color(1.0, 1.0, 1.0, 1.0, 0, 0, 0), -- r1.0 g1.0 b1.0 a1.0 0r 0g 0b (the last three are offsets)
    FLYING = false
}

function Mod:onCache(player, cacheFlag)
    if player:GetName() == "Tormented Apollyon" then
        player:AddNullCostume(characterCostume)
        if cacheFlag == CacheFlag.CACHE_SPEED then
            player.MoveSpeed = player.MoveSpeed - 1 + Template.SPEED
        end
        if cacheFlag == CacheFlag.CACHE_FIREDELAY then
            player.MaxFireDelay = player.MaxFireDelay - 10 + Template.FIREDELAY
        end
        if cacheFlag == CacheFlag.CACHE_DAMAGE then
            player.Damage = player.Damage - 3.5 + Template.DAMAGE
        end
        if cacheFlag == CacheFlag.CACHE_RANGE then
            player.TearRange = player.TearRange - 260 + Template.RANGE
            player.TearHeight = player.TearHeight + Template.TEARHEIGHT
            player.TearFallingSpeed = player.TearFallingSpeed + Template.TEARFALLINGSPEED
        end
        if cacheFlag == CacheFlag.CACHE_SHOTSPEED then
            player.ShotSpeed = player.ShotSpeed - 1 + Template.SHOTSPEED
        end
        if cacheFlag == CacheFlag.CACHE_LUCK then
            player.Luck = player.Luck + Template.LUCK
        end
        if cacheFlag == CacheFlag.CACHE_TEARFLAG then
            player.TearFlags = player.TearFlags | Template.TEARFLAG -- The OR here makes sure that if you have an item that changes tear flags, the values you set takes priority
        end
        if cacheFlag == CacheFlag.CACHE_TEARCOLOR then
            player.TearColor = Template.TEARCOLOR
        end
        if cacheFlag == CacheFlag.CACHE_FLYING and Template.FLYING then
            player.CanFly = true
        end
    end
end

Mod:AddCallback(ModCallbacks.MC_EVALUATE_CACHE, Mod.onCache)

local char = Isaac.GetPlayerTypeByName("Tormented Apollyon")
local item_id = Isaac.GetItemIdByName("Return")
local game = Game()
--local LilithCoolMultiplier = Isaac.GetNullItemIdByName("LilithCoolMultiplier")

function Mod:TormentedApollyonInit(player)
	if player:GetPlayerType() ~= char then
		return
	end
	
	player:SetPocketActiveItem(item_id, ActiveSlot.SLOT_POCKET, true)
	
	local pool = game:GetItemPool()
	pool:RemoveCollectible(item_id)
end

Mod:AddCallback(ModCallbacks.MC_POST_PLAYER_INIT, Mod.TormentedApollyonInit)

function Mod:GetMatterByRoomType(room, a_or_v)
	if a_or_v == 1 then
		if room:GetType() == RoomType.ROOM_DEFAULT or room:GetType() == RoomType.ROOM_TREASURE or room:GetType() == RoomType.ROOM_LIBRARY or room:GetType() == RoomType.ROOM_DUNGEON or room:GetType() == RoomType.ROOM_CHEST or room:GetType() == RoomType.ROOM_DEFAULT then
			return Isaac.GetItemIdByName("Void Matter of Treasure")
		elseif room:GetType() == RoomType.ROOM_SHOP or room:GetType() == RoomType.ROOM_ARCADE or room:GetType() == RoomType.ROOM_DICE or room:GetType() == RoomType.ROOM_BLACK_MARKET then
			return Isaac.GetItemIdByName("Void Matter of Shop")
		elseif room:GetType() == RoomType.ROOM_ERROR or room:GetType() == RoomType.ROOM_SECRET or room:GetType() == RoomType.ROOM_SUPERSECRET or room:GetType() == RoomType.ROOM_ISAACS or room:GetType() == RoomType.ROOM_BARREN or room:GetType() == RoomType.ROOM_ULTRASECRET then
			return Isaac.GetItemIdByName("Void Matter of Secret")
		elseif room:GetType() == RoomType.ROOM_BOSS or room:GetType() == RoomType.ROOM_MINIBOSS or room:GetType() == RoomType.ROOM_CHALLENGE or room:GetType() == RoomType.ROOM_BOSSRUSH then
			return Isaac.GetItemIdByName("Void Matter of Boss")
		elseif room:GetType() == RoomType.ROOM_ANGEL or room:GetType() == RoomType.ROOM_SACRAFICE then
			return Isaac.GetItemIdByName("Void Matter of Angel")
		elseif room:GetType() == RoomType.ROOM_DEVIL then
			return Isaac.GetItemIdByName("Void Matter of Devil")
		elseif room:GetType() == RoomType.ROOM_CURSE then
			return Isaac.GetItemIdByName("Void Matter of Curse")
		elseif room:GetType() == RoomType.ROOM_PLANETARIUM then
			return Isaac.GetItemIdByName("Void Matter of Planetatium")
		else
			return Isaac.GetItemIdByName("Abyss Matter of Secret")
		end
	else
		if room:GetType() == RoomType.ROOM_DEFAULT or room:GetType() == RoomType.ROOM_TREASURE or room:GetType() == RoomType.ROOM_LIBRARY or room:GetType() == RoomType.ROOM_DUNGEON or room:GetType() == RoomType.ROOM_CHEST or room:GetType() == RoomType.ROOM_DEFAULT then
			return Isaac.GetItemIdByName("Abyss Matter of Treasure")
		elseif room:GetType() == RoomType.ROOM_SHOP or room:GetType() == RoomType.ROOM_ARCADE or room:GetType() == RoomType.ROOM_DICE or room:GetType() == RoomType.ROOM_BLACK_MARKET then
			return Isaac.GetItemIdByName("Abyss Matter of Shop")
		elseif room:GetType() == RoomType.ROOM_ERROR or room:GetType() == RoomType.ROOM_SECRET or room:GetType() == RoomType.ROOM_SUPERSECRET or room:GetType() == RoomType.ROOM_ISAACS or room:GetType() == RoomType.ROOM_BARREN or room:GetType() == RoomType.ROOM_ULTRASECRET then
			return Isaac.GetItemIdByName("Abyss Matter of Secret")
		elseif room:GetType() == RoomType.ROOM_BOSS or room:GetType() == RoomType.ROOM_MINIBOSS or room:GetType() == RoomType.ROOM_CHALLENGE or room:GetType() == RoomType.ROOM_BOSSRUSH then
			return Isaac.GetItemIdByName("Abyss Matter of Boss")
		elseif room:GetType() == RoomType.ROOM_ANGEL or room:GetType() == RoomType.ROOM_SACRAFICE then
			return Isaac.GetItemIdByName("Abyss Matter of Angel")
		elseif room:GetType() == RoomType.ROOM_DEVIL then
			return Isaac.GetItemIdByName("Abyss Matter of Devil")
		elseif room:GetType() == RoomType.ROOM_CURSE then
			return Isaac.GetItemIdByName("Abyss Matter of Curse")
		elseif room:GetType() == RoomType.ROOM_PLANETARIUM then
			return Isaac.GetItemIdByName("Abyss Matter of Planetatium")
		else
			return Isaac.GetItemIdByName("Abyss Matter of Secret")
		end
	end
end

function Mod:TormentedApollyonOnNewRoomEnterChangeToMatter(player)
	if Game():GetRoom():IsFirstVisit() and Isaac.GetPlayer(0):GetPlayerType() == char then
		if Game():GetRoom():GetType() == RoomType.ROOM_BOSS or Game():GetRoom():GetType() == RoomType.ROOM_MINIBOSS or Game():GetRoom():GetType() == RoomType.ROOM_CHALLENGE or Game():GetRoom():GetType() == RoomType.ROOM_BOSSRUSH then ApollyonData.DoConvertOnBossClear = ApollyonData.DoConvertOnBossClear + 1 end
		local pedestals = Isaac.FindByType(EntityType.ENTITY_PICKUP, PickupVariant.PICKUP_COLLECTIBLE)
		for i = #pedestals, 1, -1 do
			if (pedestals[i].SubType == 0) and (pedestals[i].SubType == 668) then
				table.remove(pedestals, i)
			end
			print(pedestals[i].SubType)
			print(Mod:GetMatterByRoomType(Game():GetRoom(), RandValue))
		end
		for i = #pedestals, 1, -1 do
			local pedestal = pedestals[i]
			local RandValue = math.random(2)
			pedestal:ToPickup():Morph(EntityType.ENTITY_PICKUP, PickupVariant.PICKUP_COLLECTIBLE, Mod:GetMatterByRoomType(Game():GetRoom(), RandValue), true)
		end
	end
end

Mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, Mod.TormentedApollyonOnNewRoomEnterChangeToMatter)

function Mod:MatterDevilChanceApply(chance)
	local player_foritems = Isaac.GetPlayer(0)
	local history = player_foritems:GetHistory()
	local has_curseMatter = history:SearchCollectibles(Isaac.GetItemIdByName("Void Matter of Curse"))
	if not isEmpty(curseMatter) then chance = chance + (#curseMatter*10) end
	local has_notMatter = history:SearchCollectibles(Isaac.GetItemIdByName("Void Matter of Devil"))
	if not isEmpty(notMatter) then chance = chance + (#notMatter*5) end
	local has_whyMatter = history:SearchCollectibles(Isaac.GetItemIdByName("Abyss Matter of Devil"))
	if not isEmpty(whyMatter) then chance = chance + (#whyMatter*5) end
end

Mod:AddCallback(ModCallbacks.MC_PRE_DEVIL_APPLY_ITEMS, Mod.MatterDevilChanceApply)

function Mod:MatterLocustSpawn(ct, charge, FirstTime, Slot, VarData, player)
	if ct == Isaac.GetItemIdByName("Abyss Matter of Treasure") then player:AddLocust(708, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Shop") then player:AddLocust(6, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Secret") then player:AddLocust(105, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Boss") then player:AddLocust(347, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Curse") then player:AddLocust(495, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Curse") then player:AddLocust(596, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Angel") then player:AddLocust(331, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Devil") then player:AddLocust(118, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Planetatium") then player:AddLocust(593, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Planetatium") then player:AddLocust(592, player.Position) end
	if ct == Isaac.GetItemIdByName("Abyss Matter of Planetatium") then player:AddLocust(591, player.Position) end
	
	-- Best code you've ever seen 2: Back from the dead Timestamp: 3:45 AM
	
end

Mod:AddCallback(ModCallbacks.MC_POST_ADD_COLLECTIBLE, Mod.MatterLocustSpawn)

function Mod:BossReplaceWithMatter(pickup, Variant, st)
	print("ran 1")
	if (Game():GetRoom():IsClear() and (Game():GetRoom():GetType() == RoomType.ROOM_BOSS or Game():GetRoom():GetType() == RoomType.ROOM_MINIBOSS or Game():GetRoom():GetType() == RoomType.ROOM_BOSSRUSH or Game():GetRoom():GetType() == RoomType.ROOM_CHALLENGE)) then
		print("ran 2")
		print(pickup)
		print()
		if ApollyonData.DoConvertOnBossClear > 0 and pickup == EntityType.ENTITY_PICKUP and Variant == 100 and not (st == 668 or st == 328 or st == 327 or st == 238 or st == 239 or st == 551 or st == 627) then
			print("ran 3")
			ApollyonData.DoConvertOnBossClear = ApollyonData.DoConvertOnBossClear - 1
			return {EntityType.ENTITY_PICKUP, PickupVariant.PICKUP_COLLECTIBLE, Mod:GetMatterByRoomType(Game():GetRoom(), RandValue), 0}
			--return {Type = EntityType.ENTITY_PICKUP, Variant = PickupVariant.PICKUP_COLLECTIBLE, Subtype = Mod:GetMatterByRoomType(Game():GetRoom(), RandValue), Seed = 0}
		end
	end
end

Mod:AddCallback(ModCallbacks.MC_PRE_ENTITY_SPAWN, Mod.BossReplaceWithMatter)

function Mod:ApollyonPostShopRestock()
	Mod:TormentedApollyonOnNewRoomEnterChangeToMatter(Isaac.GetPlayer(0))
end

Mod:AddCallback(ModCallbacks.MC_POST_RESTOCK_SHOP, Mod.ApollyonPostShopRestock)

function Mod:OnItemPickupGiveHeart(Collectible_type, charge, FirstTime, Slot, VarData, player)

	if Collectible_type == Isaac.GetItemIdByName("Abyss Matter of Shop") or Collectible_type == Isaac.GetItemIdByName("Void Matter of Shop") then
		player.AddMaxHearts(player, 2)
		print("randsadadads")
		player.AddHearts(player, 4)
	end

end

Mod:AddCallback(ModCallbacks.MC_POST_ADD_COLLECTIBLE, Mod.OnItemPickupGiveHeart)